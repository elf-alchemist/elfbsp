---
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  google-runtime-int,
  misc-*,
  -misc-include-cleaner,
  -misc-non-private-member-variables-in-classes,
  -misc-use-internal-linkage,
  -misc-use-anonymous-namespace,
  -misc-no-recursion,
WarningsAsErrors: ''
HeaderFileExtensions:
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: ''
ExcludeHeaderFilterRegex: ''
FormatStyle: none
User: alchemist
SystemHeaders: false
CheckOptions:
  # Suggest standard library types with _t suffix
  - key: google-runtime-int.TypeSuffix
    value: _t
...
