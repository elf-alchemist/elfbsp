---
Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  misc-explicit-constructor,
  misc-const-correctness,
WarningsAsErrors: ''
HeaderFileExtensions:
  - h
  - hh
  - hpp
  - hxx
ImplementationFileExtensions:
  - c
  - cc
  - cpp
  - cxx
HeaderFilterRegex: ''
ExcludeHeaderFilterRegex: ''
FormatStyle: none
User: alchemist
CheckOptions: {}
SystemHeaders: false
...
